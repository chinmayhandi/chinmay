      "source": [
        "# 🎬 Movie Rating Prediction using RNN (LSTM)\n",
        "# --------------------------------------------\n",
        "import pandas as pd\n",
        "import numpy as np\n",
        "import tensorflow as tf\n",
        "from tensorflow.keras.preprocessing.text import Tokenizer\n",
        "from tensorflow.keras.preprocessing.sequence import pad_sequences\n",
        "from tensorflow.keras.models import Model\n",
        "from tensorflow.keras.layers import Input, Embedding, LSTM, Dense, Dropout, Concatenate\n",
        "from sklearn.model_selection import train_test_split\n",
        "from sklearn.preprocessing import MinMaxScaler\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "# 1️⃣ Load the datasets\n",
        "movies = pd.read_csv(\"/content/tmdb_5000_movies.csv\")\n",
        "credits = pd.read_csv(\"/content/tmdb_5000_credits.csv\")\n",
        "\n",
        "# 2️⃣ Fix column names and merge\n",
        "credits.rename(columns={'movie_id': 'id', 'title': 'credit_title'}, inplace=True)\n",
        "df = movies.merge(credits, on='id')\n",
        "\n",
        "# 3️⃣ Handle title column safely\n",
        "if 'title_x' in df.columns:\n",
        "    title_col = 'title_x'\n",
        "elif 'title' in df.columns:\n",
        "    title_col = 'title'\n",
        "elif 'credit_title' in df.columns:\n",
        "    title_col = 'credit_title'\n",
        "else:\n",
        "    raise KeyError(\"No title column found!\")\n",
        "\n",
        "# 4️⃣ Select useful columns\n",
        "df = df[[title_col, 'overview', 'budget', 'popularity', 'runtime', 'vote_average']]\n",
        "df.rename(columns={title_col: 'title'}, inplace=True)\n",
        "df.dropna(inplace=True)\n",
        "\n",
        "print(\"✅ Data Loaded Successfully!\")\n",
        "print(df.head())\n",
        "\n",
        "# 5️⃣ Text preprocessing (movie overviews)\n",
        "texts = df['overview'].astype(str)\n",
        "\n",
        "tokenizer = Tokenizer(num_words=10000, oov_token=\"<OOV>\")\n",
        "tokenizer.fit_on_texts(texts)\n",
        "sequences = tokenizer.texts_to_sequences(texts)\n",
        "padded = pad_sequences(sequences, maxlen=200, truncating='post', padding='post')\n",
        "\n",
        "# 6️⃣ Numeric features\n",
        "num_features = df[['budget', 'popularity', 'runtime']].values\n",
        "scaler = MinMaxScaler()\n",
        "num_features = scaler.fit_transform(num_features)\n",
        "\n",
        "# 7️⃣ Target variable (IMDB rating)\n",
        "y = df['vote_average'].values\n",
        "\n",
        "# 8️⃣ Train-Test Split\n",
        "X_text_train, X_text_test, X_num_train, X_num_test, y_train, y_test = train_test_split(\n",
        "    padded, num_features, y, test_size=0.2, random_state=42\n",
        ")\n",
        "\n",
        "# 9️⃣ Build RNN Model (LSTM)\n",
        "text_input = Input(shape=(200,))\n",
        "num_input = Input(shape=(3,))\n",
        "\n",
        "embedding = Embedding(input_dim=10000, output_dim=64, input_length=200)(text_input)\n",
        "lstm = LSTM(64, dropout=0.2, recurrent_dropout=0.2)(embedding)\n",
        "\n",
        "merged = Concatenate()([lstm, num_input])\n",
        "dense1 = Dense(64, activation='relu')(merged)\n",
        "drop1 = Dropout(0.3)(dense1)\n",
        "output = Dense(1, activation='linear')(drop1)\n",
        "\n",
        "model = Model(inputs=[text_input, num_input], outputs=output)\n",
        "model.compile(optimizer='adam', loss='mse', metrics=['mae'])\n",
        "\n",
        "model.summary()\n",
        "\n",
        "# 🔟 Train Model\n",
        "history = model.fit(\n",
        "    [X_text_train, X_num_train], y_train,\n",
        "    validation_data=([X_text_test, X_num_test], y_test),\n",
        "    epochs=5,\n",
        "    batch_size=64,\n",
        "    verbose=1\n",
        ")\n",
        "\n",
        "# 🔹 Evaluate Model\n",
        "loss, mae = model.evaluate([X_text_test, X_num_test], y_test)\n",
        "print(f\"\\n🎯 Test MAE: {mae:.3f}\")\n",
        "\n",
        "# 📈 Plot MAE history\n",
        "plt.plot(history.history['mae'], label='Train MAE')\n",
        "plt.plot(history.history['val_mae'], label='Validation MAE')\n",
        "plt.title('Model MAE')\n",
        "plt.xlabel('Epoch')\n",
        "plt.ylabel('MAE')\n",
        "plt.legend()\n",
        "plt.show()\n"
      ],
